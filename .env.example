# ==============================================================================
# ElevateCV — Environment Configuration Template
# Copy this file to .env (or backend/.env and frontend/.env.local) and fill in
# your real credentials. NEVER commit files containing real keys or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RESUME_STORAGE_BUCKET=resumes
RESUME_MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# AI Provider Configuration (Multi-provider LLMs)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDERS=anthropic,openai
AI_TIMEOUT_MS=30000

# Local AI / Hugging Face model cache directory
HF_CACHE_DIR=.cache/huggingface
